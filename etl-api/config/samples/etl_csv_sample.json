{
  "pipeline": {"name": "csv-filter", "version": "1.0"},
  "datasource": {
    "type": "csv",
    "filePath": "data//input.csv",
    "delimiter": ",",
    "hasHeader": true
  },
  "inputSchema": {
    "fields": [
      {"name": "order_id", "type": "LONG"},
      {"name": "customer", "type": "STRING"},
      {"name": "amount", "type": "DECIMAL"},
      {"name": "city", "type": "STRING"}
    ]
  },
  "output": {"storage": {"type": "csv", "table": "output.csv"}}
}